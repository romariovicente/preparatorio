# VITE_* values are public browser configuration, never passwords or API keys.
# Local Vite defaults to /assets and http://127.0.0.1:5180 only on loopback.
# For GitHub Pages, use the checked-in workflow and a real cloud asset manifest.
VITE_BASE_PATH=/
VITE_EXTERNAL_ASSETS_ONLY=false
# Optional shared service; production requires HTTPS. Empty keeps it disabled.
VITE_API_BASE_URL=
# Optional fallback prefix. Per-file HTTPS cloud manifest entries take precedence.
VITE_ASSET_BASE_URL=
